// local.properties:
//   BACKEND_URL=https://YOUR-SERVICE.onrender.com
//   APP_TOKEN=same-secret-you-set-on-Render
import java.util.Properties
android {
    buildFeatures { buildConfig = true }
    defaultConfig {
        val p = Properties().apply { rootProject.file("local.properties").inputStream().use { load(it) } }
        buildConfigField("String", "BACKEND_URL", "\"${p.getProperty("BACKEND_URL")}\"")
        buildConfigField("String", "APP_TOKEN", "\"${p.getProperty("APP_TOKEN")}\"")
    }
}
dependencies {
    implementation("androidx.appcompat:appcompat:1.7.0")
    implementation("com.squareup.okhttp3:okhttp:4.12.0")
}
